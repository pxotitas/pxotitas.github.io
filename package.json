{
  "name": "pxotitas-portfolio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run optimize:artworks && vite --host 0.0.0.0",
    "dev": "npm run optimize:artworks && vite --host 0.0.0.0",
    "optimize:artworks": "node scripts/optimize-artworks.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run optimize:artworks && npm run typecheck && vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
